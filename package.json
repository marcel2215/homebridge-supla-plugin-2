{
  "name": "homebridge-supla-plugin-2",
  "displayName": "Homebridge Supla Plugin 2",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "Homebridge plugin for SUPLA cloud devices using email/password authentication.",
  "author": "Marcel",
  "license": "Apache-2.0",
  "homepage": "https://github.com/marcel/homebridge-supla-plugin-2#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcel/homebridge-supla-plugin-2.git"
  },
  "bugs": {
    "url": "https://github.com/marcel/homebridge-supla-plugin-2/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supla",
    "homekit"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && npm run build:native",
    "build:native": "node scripts/build-native-helper.mjs --optional",
    "lint": "eslint . --max-warnings=0",
    "postinstall": "npm run build:native",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^7.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
